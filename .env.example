# botたん統合リポジトリの設定例。`.env` はリポジトリのルートに1本だけ置く。
# Shorts パイプライン（shorts/）とライブ配信（live/）が同じファイルを読む。

# ── LLM ──
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── DB（botたんの記憶） ──
DB_HOST=192.168.1.200
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── YouTube ──
YOUTUBE_CLIENT_SECRETS=
# Shorts 投稿の公開設定（public/private/unlisted、既定 public）。
# 配信枠のほうは LIVE_YOUTUBE_PRIVACY で別に指定する
YOUTUBE_PRIVACY=public

# ── Shorts の収録（shorts/） ──
UNITY_PROJECT=/home/suibari/bottan-video
BGM_PATH=
VRMA_MOTION_DIR=

# ── 通知 ──
DISCORD_WEBHOOK_URL=

# ── ライブ配信のスケジュール ──
# ── 配信スケジュール ──
LIVE_START_HHMM=21:00
LIVE_CLOSING_HHMM=21:55
LIVE_END_HHMM=22:00

# ── Unity 常駐 ──
UNITY_LIVE_PROJECT=/home/suibari/bottan-video-dev
LIVE_PORT=2338

# ── VOICEVOX ──
VOICEVOX_URL=http://localhost:10101
VOICEVOX_SPEAKER=8
# falseで共有DBの読み補正を緊急停止。更新は発話を止めずバックグラウンドで行う
TTS_PRONUNCIATIONS_ENABLED=true
TTS_PRONUNCIATION_REFRESH_SEC=60

# ── OBS（obs-websocket v5 を有効にしてパスワードを設定しておくこと）──
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# ── biorhythm ──
# 配信側は biorhythm_server の HTTP を叩かない（energy は共有DBの bot_state を
# 読むだけ。加算は biorhythm_server が bottan_live.comments を見て自分でやる）。
# ここは Shorts 側と将来の用途のために残してある
BIORHYTHM_URL=http://localhost:3002
# RAGクライアントはこちらを使う。biorhythm-serverとは別マシンなら
# 公開Tunnelではなく、専用のLAN内listener（例: 192.168.1.200:3204）を指定する
BIORHYTHM_MEMORY_API_URL=http://127.0.0.1:3003
# 実測（LAN内）: 100文字 1.9秒 / 300文字 3.2秒 / 500文字 4.7秒 / 1000文字 9.1秒。
# 検索はフリートークの話題の先読みにしか使わず、別スレッドで走るので
# コメントへの反応は遅くならない
BIORHYTHM_MEMORY_API_TIMEOUT_SEC=15
# 検索クエリの長さの上限[文字]。伸ばすほど検索が遅くなる（上の実測を参照）
BOT_MEMORY_QUERY_MAX_CHARS=500
# biorhythm-server の記憶検索APIと共有するBearerトークン
BIORHYTHM_INTERNAL_SECRET=
# フェーズ1は既存 type を流用する。将来 biorhythm_server に live_comment を
# 足したらここを live_comment に変えるだけでよい
ENERGY_TYPE_COMMENT=conversation

# ── ARDY ──
ARDY_PORT=2337
ARDY_REPO=/home/suibari/work/text-to-vrma
ARDY_ENGINE_ROOT=/mnt/data/ardy-engine
ARDY_MERGED_BASE=/home/suibari/ardy-models/llm2vec-base-merged

# ── 配信の振る舞い ──
# コメントがこの秒数途切れたらフリートークを挟む。90秒だと黙っている時間が
# 長すぎて放送事故に見える。短くするほど LLM と VOICEVOX の呼び出しが増える
FILLER_IDLE_SEC=25
# クロージングの何秒前からフリートークと掘り下げをやめ、コメント消化に専念するか
FILLER_STOP_LEAD_SEC=120
# 直近の発話からこの秒数空いたら、いま話しているテーマを掘り下げる
FOLLOWUP_IDLE_SEC=8
# 1つのテーマを何回まで掘るか
FOLLOWUP_MAX_DEPTH=2
# テーマの寿命[秒]。これを過ぎたら掘り下げず、新しい話題へ移る
FOLLOWUP_TTL_SEC=120
COMMENT_USER_COOLDOWN_SEC=60
# 一般視聴者のコメントをこの秒数まで待たせたら、返事せずに捨てる。
# 0 で無効。スパチャ・メンバー・オーナーは古くても捨てない
COMMENT_MAX_AGE_SEC=180
# LLM へ会話履歴として渡す場の流れのターン数と、相手ごとに覚えておくターン数
LIVE_HISTORY_TURNS=6
LIVE_HISTORY_USER_TURNS=3
# mood（さっきまでしてたこと）を1つあたり何回プロンプトに載せてよいか。
# 載せ続けると1時間の配信の全発話が同じ行動の話になる
BOT_MOOD_SERVE_LIMIT=1

# ── 運用 ──
# true にすると YouTube に一切触らずローカルだけで回す
DRY_RUN=false
FAKE_COMMENTS=
LIVE_YOUTUBE_PRIVACY=private

# ── 構図・音声・待機演出 ─────────────────────────
LIVE_CAMERA_X=-0.25
LIVE_CAMERA_Z=0.70
LIVE_LIGHT_INTENSITY=0.85
# 空ならカメラの方を向く。負で画面の内側（コメント欄側）へ
LIVE_CHARACTER_YAW=
# 0 にすると喋り終わったあと口が開いたままになる
LIVE_MOUTH_CLOSE=1.0
# Unity の音を OBS へ渡す null シンク（OBS は <名前>.monitor を拾う）
LIVE_AUDIO_SINK=bottan_live

# OBS が読む字幕・コメント欄の置き場。**リポジトリの外**に置く。
# OBS のシーンは絶対パスでファイルを掴むので、リポジトリ内に置くと
# 「本番が走っているのに OBS は dev のファイルを見ている」状態になる
# （統合前に実際にそうなっていた）。本番・dev のどちらが走っても同じ場所を書く。
SUBTITLE_DIR=/home/suibari/.local/share/bottan-live/obs
# 字幕を出すタイミングの微調整[秒]。0=Unity が鳴らし始めてから出す（既定）、
# 正=そのぶん遅らせる、負=鳴り始めを待たずに先に出す。
# 字幕は obs-websocket で直接流し込むので、ファイル経由の約1秒遅れは無い
SUBTITLE_LEAD_SEC=0
IDLE_ENABLED=true
# 黙っているときにモーションを投げる間隔[秒]。
# 発話中はこの間隔ではなく「クリップの尺 - 0.5秒」で継ぎ足し続ける（棒立ちに戻さない）
# しぐさの間隔。1本が約9秒なので、9〜20秒だと待機時間の4割は棒立ちになる
IDLE_MOTION_MIN_SEC=6
IDLE_MOTION_MAX_SEC=20
# 表情を動かす間隔。Unity 側が Lerp で繋ぐので短くしても百面相にはならない
IDLE_EMOTION_MIN_SEC=3
IDLE_EMOTION_MAX_SEC=8
# ほほえみパルスを保つ長さ[秒]
IDLE_SMILE_HOLD_SEC=1.5
# 配信用モーション1本の作り方。ARDY 側で blendSec のクロスフェードを掛けて
# 1本に繋いでもらう（3セグメント × 3.0秒 ≒ 9秒）。
# 短くすると /motion の回数が増え、そのたびに Unity がメインスレッドで
# .vrma をパースするのでフレームが落ちやすくなる
ARDY_LIVE_DURATION=3.0
LIVE_MOTION_SEGMENTS=3
# Unity の fps をログへ残す間隔[秒]
FPS_LOG_SEC=60
# LLM 1リクエストの上限[秒]。実測は約2秒。指定しないと SDK 既定の600秒になる
LLM_TIMEOUT_SEC=20
# DB(PostgreSQL) の接続待ちの上限[秒]。配信中はここがコメントへの反応の遅れになる
DB_CONNECT_TIMEOUT=3
# botたんの状態を DB から引き直す間隔[秒]。energy は分単位でしか動かない
BOT_CONTEXT_TTL_SEC=20
