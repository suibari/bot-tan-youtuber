[Unit]
Description=botたん YouTube ライブ配信 (21:00-22:00)
# 映像は GPU 仮想ディスプレイの上に出すので、先に上がっている必要がある。
# 引くのは Xorg そのものではなく bottan-live-display.service のほう。あちらが
# 毎晩 Xorg を作り直し、glxgears で実際に描けることを確かめてから通す。
#
# **bottan-live-xorg.service を直接 Requires= しないこと。** 準備ユニットが
# その Xorg を restart するので、依存として宣言していると systemd が
# 「依存先が明示的に停止された」とみなして配信ユニットごと巻き添えで落とす。
#
# 長く上げっぱなしの Xorg は、あるとき表示経路だけが止まる（2026-09-10 の配信は
# 0.1〜1.9fps の止まった絵を14分流した）。原因は未特定なので作り直しで避ける。
# 準備が通らなければ配信は始まらない。詳細は setup/reset_display.sh
Requires=bottan-live-display.service
After=bottan-live-display.service network-online.target
Wants=network-online.target
# 画像生成サイドカー（bot-tan-imagegen）は配信中に使わないので退かす。
# あちらは常駐でアイドル時に解放しても RSS 約1.9GB を掴んだままで、
# 2026-09-09 の配信では 543MB＋swap 1.0GB を占めていた。ホストは 31GB しか
# 無く、ollama(9.4GB)・ARDY・Unity・OBS・VOICEVOX が同居して commit が
# RAM+swap の 110% に達し、OBS の送出が止まって YouTube に配信を切られた。
# Conflicts= は「こちらが起動したら向こうを止める」。戻すのは ExecStopPost。
Conflicts=imagegen.service

[Service]
Type=oneshot
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/run_live.sh
# flatpak の OBS は、セッションバス越しでないと PulseAudio へ橋を架けられない。
# systemd から起動すると DBUS_SESSION_BUS_ADDRESS が無いので
# 「pulse-input: Unable to get server info !」となり、映像だけの無音配信になる。
# ログインセッションの値をそのまま渡す（__USER__ がデスクトップにログインしている
# 前提。していないなら loginctl enable-linger __USER__ を入れておくこと）
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus
# 20:40 起動で 22:00 終了。ARDY の読み込み4〜5分と flock の待ちを含めて余裕を見る
TimeoutStartSec=6000
# 配信が落ちたら自動で上げ直さない。中途半端な時刻に配信枠が増えるほうが困る
Restart=no
# Conflicts= で止めた画像生成サイドカーを戻す。`+` を付けると User= に関係なく
# root で走るので、suibari に systemctl の sudoers を書かなくて済む。
# 配信の成否によらず動くよう ExecStopPost に置く（ExecStop では異常終了時に
# 走らない経路がある）。
# `-` は失敗を無視する指定。**これを外さないこと。** imagegen を入れていない
# 環境（dev の worktree など）ではこの systemctl が失敗し、Type=oneshot だと
# ExecStopPost の失敗がユニット全体の failed になる。配信そのものは終わって
# いるのに「配信が落ちた」ことになってしまう
ExecStopPost=-+/usr/bin/systemctl start --no-block imagegen.service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
