[Unit]
Description=botたんライブ配信用 GPU 仮想ディスプレイ (Xorg :99)
Documentation=https://github.com/suibari
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
# Xorg は -config にフルパスを渡す場合 root 権限が要る（非rootでは
# 標準の場所しか読めない制限がある）
User=root
# -sharevts -novtswitch: VT を取らない・切り替えない。付けないと空いている VT
# （実測 VT2）を取ってコンソールをそこへ切り替え、デスクトップ（VT3）が隠れる。
# :99 は何も映さず入力も読まないので、画面は真っ黒でマウスも効かなくなる
# （2026-09-14 20:40 の作り直し後に発生。戻すには sudo chvt 3）
ExecStart=/usr/bin/Xorg :99 -config /etc/X11/xorg-bottan-live.conf -sharevts -novtswitch -noreset -nolisten tcp -logfile /var/log/Xorg.99.log
# 配信中に落ちたら映像が止まる。必ず上げ直す
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
